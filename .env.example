# =============================================================================
# SmartParking Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================================

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=smart_parking
MYSQL_USER=parking_user
MYSQL_PASSWORD=parking_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# MySQL AI read-only user (must match infra/mysql/init/01_schema.sql)
MYSQL_AI_USER=ai_reader
MYSQL_AI_PASSWORD=ai_reader_pass

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ALGORITHM=HS256

# Razorpay (Test Mode) — get keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# AI Service (internal, not exposed to host)
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=change-me-to-a-service-token
AI_SERVICE_TIMEOUT_SECS=2

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECS=20

# Booking Defaults
HOLD_MINUTES=10
MIN_DURATION_MINUTES=30
MAX_DURATION_HOURS=24
BOOKING_GRANULARITY_MINUTES=15
PER_USER_PENDING_LIMIT=3

# SMTP (Mailpit in dev — UI at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartparking.local
SMTP_TLS=false

# App
APP_NAME=SmartParking
FRONTEND_URL=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CHAT=20/minute
